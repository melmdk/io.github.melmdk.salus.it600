  "flow": {
    "triggers": [
      {
        "title": {
          "en": "A problem started"
        },
        "hint": {
          "en": "Triggers when a device reports a problem it did not report before."
        },
        "tokens": [
          {
            "name": "device",
            "type": "string",
            "title": {
              "en": "Device"
            },
            "example": {
              "en": "Kældertrappe"
            }
          },
          {
            "name": "problem",
            "type": "string",
            "title": {
              "en": "Problem"
            },
            "example": {
              "en": "Low battery"
            }
          }
        ],
        "id": "problem_started"
      }
    ]
  },
  "drivers": [
