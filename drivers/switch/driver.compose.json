{
  "name": {
    "en": "Smart Plug"
  },
  "class": "socket",
  "capabilities": [
    "onoff"
  ],
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "pair": [
    {
      "id": "gateway_credentials",
      "template": "login_credentials",
      "options": {
        "title": {
          "en": "Connect to Gateway"
        },
        "usernameLabel": {
          "en": "Gateway IP Address"
        },
        "usernamePlaceholder": {
          "en": "Leave empty to use the saved gateway"
        },
        "passwordLabel": {
          "en": "Gateway EUID"
        },
        "passwordPlaceholder": {
          "en": "16 characters from the gateway label"
        }
      }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "repair": [
    {
      "id": "gateway_credentials",
      "template": "login_credentials",
      "options": {
        "title": {
          "en": "Connect to Gateway"
        },
        "usernameLabel": {
          "en": "Gateway IP Address"
        },
        "usernamePlaceholder": {
          "en": "Leave empty to use the saved gateway"
        },
        "passwordLabel": {
          "en": "Gateway EUID"
        },
        "passwordPlaceholder": {
          "en": "16 characters from the gateway label"
        }
      }
    },
    {
      "id": "done",
      "template": "done"
    }
  ],
  "images": {
    "small": "/drivers/switch/assets/images/small.png",
    "large": "/drivers/switch/assets/images/large.png",
    "xlarge": "/drivers/switch/assets/images/xlarge.png"
  }
}
